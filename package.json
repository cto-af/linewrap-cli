  },
  "devDependencies": {
    "@cto.af/eslint-config": "6.2.5",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "eslint-plugin-mocha": "^11.2.0",
    "superc8": "^12.3.1"
